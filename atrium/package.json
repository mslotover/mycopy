{
  "name": "atrium",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev -c wrangler.dev.jsonc",
    "build": "vite build && node scripts/embed-assets.mjs --off",
    "typecheck": "node scripts/embed-assets.mjs --off && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "db:local": "wrangler d1 migrations apply atrium --local -c wrangler.dev.jsonc",
    "db:remote": "wrangler d1 migrations apply atrium --remote",
    "seed:local": "node scripts/seed-demo.mjs | wrangler d1 execute atrium --local --file=/dev/stdin",
    "deploy": "npm run build && wrangler deploy",
    "deploy:embedded": "vite build && node scripts/embed-assets.mjs && wrangler deploy -c wrangler.embedded.gen.jsonc"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@floating-ui/dom": "^1.8.0",
    "@tanstack/react-query": "^5.107.1",
    "@tiptap/extension-highlight": "^3.33.1",
    "@tiptap/extension-image": "^3.33.1",
    "@tiptap/extension-list": "^3.33.1",
    "@tiptap/extension-mention": "^3.33.1",
    "@tiptap/extension-table": "^3.33.1",
    "@tiptap/extensions": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "@tiptap/suggestion": "^3.33.1",
    "dompurify": "^3.4.17",
    "hono": "^4.13.18",
    "lucide-react": "^1.72.0",
    "marked": "^18.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.160.1"
  }
}
