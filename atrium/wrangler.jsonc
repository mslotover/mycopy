{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atrium",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atrium",
      "database_id": "ebce5692-af19-40dc-9e7d-f5e46b73ecdd",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "atrium-files" }],
  "ai": { "binding": "AI" },
  // Meaning-based search (created with: wrangler vectorize create atrium-search --dimensions=1024 --metric=cosine).
  "vectorize": [{ "binding": "VECTORS", "index_name": "atrium-search" }],
  // Business figures for Ask AI, from the Toklas data connector (needs the ATRIUM_DATA_KEY secret).
  "services": [{ "binding": "DATA", "service": "toklas-data-connector" }],
  // A single five-minute timer; src/worker/index.ts runs each job at its time of day.
  // (The Workers free plan allows five timers across the whole account.)
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "APP_NAME": "Atrium",
    "APP_URL": "https://atrium.tmfgroup.workers.dev",
    "MAIL_FROM": "Atrium <atrium@reports.toklas.co.uk>",
    "CLAUDE_MODEL": "claude-opus-5-5",
    "WHISPER_MODEL": "@cf/openai/whisper-large-v3-turbo",
    "VAPID_PUBLIC_KEY": "BAOjknmiLCutJTs-6d3xCAjUMHd_CPCp-5RBccBS217qga8lE8ARxgv4N4R9q7ZdTputXHBIYhFx1W4uzU3ne5E"
  }
  // Secrets (set with `wrangler secret put`): ANTHROPIC_API_KEY, RESEND_API_KEY,
  // VAPID_PRIVATE_KEY (the private half of VAPID_PUBLIC_KEY, for phone notifications),
  // ATRIUM_DATA_KEY (same value as ATRIUM_KEY on toklas-data-connector),
  // optional ANTHROPIC_ADMIN_KEY (Console figure in the weekly spending email),
  // REPORT_TO (who gets the weekly spending email) and BRIEF_RECIPIENTS (comma-separated
  // emails that get the morning brief) - kept as secrets because this repository is public.
  // optional GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET for Google sign-in.
}
